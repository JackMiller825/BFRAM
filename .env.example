# Copy into `.env` only on the machine that runs the studio server.
# Values here are blank on purpose. Do not commit a filled-in .env file.

# Owner sessions live in data/studio.json. This key is reserved for encrypting
# future OAuth tokens at rest. Telegram uses the bot token below and does not
# copy it into the database.
STUDIO_TOKEN_KEY=

# Telegram Bot API token from BotFather. The studio posts only where getChatMember
# shows this bot as administrator or creator.
TELEGRAM_BOT_TOKEN=

# Detected but unused until those OAuth flows are implemented.
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
